# Copy to .env and fill in. Real environment variables win over this file.

# ---------------------------------------------------------------------------
# Telegram (my.telegram.org -> API development tools)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram.session

# ---------------------------------------------------------------------------
# Local LM Studio
# ---------------------------------------------------------------------------
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TIMEOUT=300
TEMPERATURE=0.7
# Reasoning models (gemma-4, qwen3.5, deepseek-r1) burn hundreds of tokens
# thinking before writing a word. Below ~400 they return an empty message.
MAX_TOKENS=2000
# Reasoning models think for hundreds of tokens before replying. Measured on
# gemma-4-e4b: 21.9s with thinking on vs 7.6s off, same output quality.
DISABLE_THINKING=true

# ---------------------------------------------------------------------------
# Voice of the follow-up
# ---------------------------------------------------------------------------
YOUR_NAME=
PERSONA=Keep it warm and casual, lowercase is fine.
FALLBACK_TEXT=Sorry, I couldn't pick up just now — I'll get back to you shortly.
# Appended verbatim on its own line to every message. Leave empty for no signature.
SIGNOFF=
MAX_CHARS=300
HISTORY_MESSAGES=10

# ---------------------------------------------------------------------------
# Safety - leave DRY_RUN on until you have watched a few real calls
# ---------------------------------------------------------------------------
DRY_RUN=true
COOLDOWN_MINUTES=30
# Hold off this long after a call so you can answer by hand first. If you do,
# the follow-up is cancelled. Generation happens during this window, not after.
REPLY_GRACE_SECONDS=30
# Comma-separated substrings matched against contact name or id.
# ALLOW non-empty means ONLY those contacts get a reply. Empty = everyone replies.
# If you configure it, pre-resolves WhatsApp LIDs at startup so first-call history
# works. Leave empty to discover LIDs from incoming messages — works fine but takes
# ~1-2 messages. Example: ALLOW=+880178730821,+8801904889984,Shujoy,Mahmud
ALLOW=
BLOCK=
# Comma-separated HH:MM-HH:MM windows; wrapping past midnight is fine.
QUIET_HOURS=23:00-07:00

# ---------------------------------------------------------------------------
# Brain HTTP endpoint (the Node WhatsApp watcher talks to this)
# ---------------------------------------------------------------------------
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8787

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_PATH=data/followups.sqlite3
LOG_LEVEL=INFO
LOG_FILE=logs/call-followup.log

# ---------------------------------------------------------------------------
# Burst replies - a fixed "he's busy, automated reply" after several unanswered
# messages from the same person. No LLM: instant, and it cannot improvise at
# someone who may be upset. OFF by default; spammier than call follow-ups and
# closer to the bulk-automation pattern WhatsApp's anti-spam targets.
# ---------------------------------------------------------------------------
BURST_REPLY_ENABLED=false
BURST_THRESHOLD=5
BURST_COOLDOWN_HOURS=6
BURST_TEXT=Hi, this is an automated reply — I am busy at the moment and have not seen your messages yet. I will get back to you as soon as I can.
